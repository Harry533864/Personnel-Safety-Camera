FLASK_DEBUG=True
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
SECRET_KEY=
DATABASE_URL=postgresql://username:password@localhost/databasename

VITE_FLASK_BACKEND_URL=http://your_ip:5000
VITE_VIDEO_STREAM_URL=http://your_ip:8889

# Backend camera source. Use usb for UVC/V4L2 cameras, csi for Jetson CSI/Argus.
CAMERA_SOURCE=usb

# USB profile, kept separate so it is easy to switch back.
USB_CAMERA_DEVICE=/dev/video0
USB_CAMERA_WIDTH=1920
USB_CAMERA_HEIGHT=1080
USB_CAMERA_FPS=60
USB_CAMERA_FOURCC=MJPG

# CSI profile for IMX219 on Jetson Orin Nano.
CSI_SENSOR_ID=0
CSI_FLIP_METHOD=0
CSI_CAMERA_WIDTH=1920
CSI_CAMERA_HEIGHT=1080
CSI_CAMERA_FPS=30
